# Cloudflare API token with permissions:
# - Zone:Read, Zone:Edit, Zone Settings:Edit
# - DNS:Edit
# - Access: Apps and Policies Write
# - Access: Organizations, Identity Providers, and Groups Write
#
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Account ID from Cloudflare dashboard (right sidebar on any zone page)
CLOUDFLARE_ACCOUNT_ID=

# Google OAuth credentials for Cloudflare Access "Sign in with Google"
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (Cloudflare shows this when adding Google IdP):
#   https://<your-team>.cloudflareaccess.com/cdn-cgi/access/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain (default shown; usually no need to change)
DOMAIN=thewitzel.family
